[node name: "MainGameScene"]
class_name MainGameScene
extends Node2D

func _ready():
    # Initialize game systems
    get_tree().paused = false
    
    # Create game manager
    var manager = GameManager.instance()
    get_node("/root").add_child(manager)
    
    # Create UI
    var ui = UI.instance()
    get_node("/root").add_child(ui)
    manager.register_ui(ui)
    
    # Create player
    var player_scene = preload("res://scenes/player/player_scene.tscn")
    var player = player_scene.instance()
    get_node("/root").add_child(player)
    manager.set_player(player)
    
    # Create touch controls for Android
    var touch = preload("res://touch_controls.gd").instance()
    get_node("/root").add_child(touch)
    touch.show()
    
    # Start first level
    manager.start_level(1)
    manager.change_world(1)

func _process(delta):
    # Handle pause
    if Input.is_action_justpressed("ui_menu"):
        get_tree().paused = not get_tree().paused